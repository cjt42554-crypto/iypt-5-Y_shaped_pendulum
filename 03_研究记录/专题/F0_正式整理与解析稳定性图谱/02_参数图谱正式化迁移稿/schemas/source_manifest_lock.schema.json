{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/iypt5/yps-formal-pattern-atlas-source-lock-1.0.schema.json",
  "title": "Closed source and runtime lock for the candidate ideal-torus atlas",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "atlas_identity", "entries", "runtime_identity", "runtime_identity_sha256"],
  "properties": {
    "schema": {"const": "YPS-FORMAL-PATTERN-ATLAS-SOURCE-LOCK-1.0"},
    "atlas_identity": {"const": "YPS-IDEAL-TORUS-PATTERN-ATLAS-DRAFT-1.1"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceEntry"}
    },
    "runtime_identity": {"$ref": "#/$defs/runtimeIdentity"},
    "runtime_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256"],
      "properties": {
        "role": {
          "enum": [
            "formal_theory",
            "formal_contracts",
            "formal_backend",
            "production_source",
            "configuration",
            "schema",
            "build_metadata"
          ]
        },
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "python_implementation",
        "python_version",
        "platform_system",
        "platform_machine",
        "packages"
      ],
      "properties": {
        "schema": {"const": "YPS-FORMAL-PATTERN-ATLAS-RUNTIME-IDENTITY-1.0"},
        "python_implementation": {"const": "CPython"},
        "python_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"},
        "platform_system": {"type": "string", "minLength": 1},
        "platform_machine": {"type": "string", "minLength": 1},
        "packages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jsonschema", "matplotlib", "numpy", "scipy"],
          "properties": {
            "jsonschema": {"type": "string", "minLength": 1},
            "matplotlib": {"type": "string", "minLength": 1},
            "numpy": {"type": "string", "minLength": 1},
            "scipy": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
