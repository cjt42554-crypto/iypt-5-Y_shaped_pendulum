[Desktop Entry]
Type=Application
Version=1.0
Name=Y-Pendulum Simulator
Name[zh_CN]=Y 形摆模拟器
GenericName=Scientific Simulator
GenericName[zh_CN]=科研模拟工具
Comment=Open the offline FWD cable and discrete flexible-rod Y-pendulum desktop
Comment[zh_CN]=打开前向柔索与离散柔性杆后端的本地 Y 形摆科研桌面
Exec=bash -c 'entry="$1"; cd -- "$(dirname -- "$entry")"; exec ./启动Y形摆审查后修订版.sh' bash %k
Icon=applications-science
Terminal=false
StartupNotify=true
DBusActivatable=false
Categories=Science;Physics;
Keywords=Y pendulum;Bowditch pendulum;IYPT;simulation;physics;
