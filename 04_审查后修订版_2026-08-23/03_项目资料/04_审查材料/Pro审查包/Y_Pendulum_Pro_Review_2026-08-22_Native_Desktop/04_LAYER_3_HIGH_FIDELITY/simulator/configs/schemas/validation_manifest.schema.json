{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YP-FPSim validation manifest v1.0",
  "type": "object",
  "required": [
    "schema_version",
    "frozen",
    "passed",
    "claim_level",
    "frozen_at_utc",
    "model_definition_hash_sha256",
    "calibration_runs",
    "validation_runs",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "frozen": {
      "const": true
    },
    "passed": {
      "type": "boolean"
    },
    "claim_level": {
      "enum": [
        "VALIDATED",
        "PREDICTIVE"
      ]
    },
    "frozen_at_utc": {
      "type": "string"
    },
    "model_definition_hash_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "calibration_runs": {
      "type": "array"
    },
    "validation_runs": {
      "type": "array",
      "minItems": 1
    },
    "metrics": {
      "type": "object",
      "minProperties": 1
    },
    "predictive_scope": {
      "type": "object"
    }
  },
  "additionalProperties": true
}