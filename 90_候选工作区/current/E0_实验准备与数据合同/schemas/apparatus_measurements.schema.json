{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/yps/e0/apparatus_measurements.schema.json",
  "title": "YPS E0R apparatus measurement register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "data_origin", "apparatus_revision", "measurements"],
  "properties": {
    "schema_id": {"const": "YPS-E0-APPARATUS-MEASUREMENTS-1.1"},
    "data_origin": {
      "enum": [
        "HUMAN_REQUIRED_TEMPLATE",
        "MEASURED_BUNDLE",
        "SYNTHETIC_REAL_SHAPE_FIXTURE"
      ]
    },
    "apparatus_revision": {"type": "string", "minLength": 1},
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/measurement"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"data_origin": {"const": "HUMAN_REQUIRED_TEMPLATE"}}},
      "then": {
        "properties": {
          "apparatus_revision": {"const": "UNSET_REQUIRES_HUMAN"},
          "measurements": {
            "items": {"properties": {"source_type": {"const": "UNSET_REQUIRES_HUMAN"}}}
          }
        }
      }
    },
    {
      "if": {"properties": {"data_origin": {"const": "MEASURED_BUNDLE"}}},
      "then": {
        "properties": {
          "apparatus_revision": {"not": {"const": "UNSET_REQUIRES_HUMAN"}},
          "measurements": {
            "items": {
              "properties": {
                "source_type": {"enum": ["MEASURED", "DERIVED_FROM_MEASURED"]}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"data_origin": {"const": "SYNTHETIC_REAL_SHAPE_FIXTURE"}}},
      "then": {
        "properties": {
          "apparatus_revision": {"pattern": "^SYNTHETIC_"},
          "measurements": {
            "items": {
              "properties": {
                "source_type": {"const": "SYNTHETIC_REAL_SHAPE_FIXTURE"}
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "nullableScalarOrVector": {
      "oneOf": [
        {"type": "null"},
        {"type": "number"},
        {"type": "array", "minItems": 1, "items": {"type": "number"}}
      ]
    },
    "nullableCovariance": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "number"}
          }
        }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature_c", "relative_humidity_percent", "pressure_pa"],
      "properties": {
        "temperature_c": {"type": ["number", "null"]},
        "relative_humidity_percent": {"type": ["number", "null"]},
        "pressure_pa": {"type": ["number", "null"]}
      }
    },
    "derivation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["formula", "input_measurement_ids", "source_sha256"],
      "properties": {
        "formula": {"type": "string", "minLength": 1},
        "input_measurement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_id",
        "component_id",
        "quantity",
        "unit",
        "operational_definition",
        "value_kind",
        "component_labels",
        "source_type",
        "raw_repeats",
        "value_si",
        "type_a_standard_uncertainty",
        "type_b_standard_uncertainty",
        "combined_standard_uncertainty",
        "covariance_si",
        "covariance_group",
        "instrument_id",
        "calibration_ref",
        "timestamp",
        "environment",
        "raw_data_sha256",
        "derivation"
      ],
      "properties": {
        "measurement_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "component_id": {"type": "string", "minLength": 1},
        "quantity": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "operational_definition": {"type": "string", "minLength": 1},
        "value_kind": {"enum": ["SCALAR", "VECTOR"]},
        "component_labels": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_type": {
          "enum": [
            "MEASURED",
            "DERIVED_FROM_MEASURED",
            "THEORY_DESIGN_CENTER",
            "ASSUMPTION_SENSITIVITY_ONLY",
            "UNSET_REQUIRES_HUMAN",
            "SYNTHETIC_REAL_SHAPE_FIXTURE"
          ]
        },
        "raw_repeats": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "number"},
              {"type": "array", "minItems": 1, "items": {"type": "number"}}
            ]
          }
        },
        "value_si": {"$ref": "#/$defs/nullableScalarOrVector"},
        "type_a_standard_uncertainty": {"$ref": "#/$defs/nullableScalarOrVector"},
        "type_b_standard_uncertainty": {"$ref": "#/$defs/nullableScalarOrVector"},
        "combined_standard_uncertainty": {"$ref": "#/$defs/nullableScalarOrVector"},
        "covariance_si": {"$ref": "#/$defs/nullableCovariance"},
        "covariance_group": {"$ref": "#/$defs/nullableString"},
        "instrument_id": {"$ref": "#/$defs/nullableString"},
        "calibration_ref": {"$ref": "#/$defs/nullableString"},
        "timestamp": {"$ref": "#/$defs/nullableString"},
        "environment": {"$ref": "#/$defs/environment"},
        "raw_data_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "derivation": {"$ref": "#/$defs/derivation"}
      },
      "allOf": [
        {
          "if": {"properties": {"value_kind": {"const": "SCALAR"}}},
          "then": {
            "properties": {
              "component_labels": {"maxItems": 0},
              "raw_repeats": {"items": {"type": "number"}},
              "value_si": {"type": ["number", "null"]},
              "type_a_standard_uncertainty": {"type": ["number", "null"]},
              "type_b_standard_uncertainty": {"type": ["number", "null"]},
              "combined_standard_uncertainty": {"type": ["number", "null"]},
              "covariance_si": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"value_kind": {"const": "VECTOR"}}},
          "then": {
            "properties": {
              "component_labels": {"minItems": 2},
              "raw_repeats": {
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "items": {"type": "number"}
                }
              },
              "value_si": {
                "oneOf": [
                  {"type": "null"},
                  {"type": "array", "minItems": 2, "items": {"type": "number"}}
                ]
              },
              "type_a_standard_uncertainty": {
                "oneOf": [
                  {"type": "null"},
                  {"type": "array", "minItems": 2, "items": {"type": "number", "minimum": 0}}
                ]
              },
              "type_b_standard_uncertainty": {
                "oneOf": [
                  {"type": "null"},
                  {"type": "array", "minItems": 2, "items": {"type": "number", "minimum": 0}}
                ]
              },
              "combined_standard_uncertainty": {
                "oneOf": [
                  {"type": "null"},
                  {"type": "array", "minItems": 2, "items": {"type": "number", "minimum": 0}}
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_type": {"enum": ["MEASURED", "SYNTHETIC_REAL_SHAPE_FIXTURE"]}
            }
          },
          "then": {
            "properties": {
              "raw_repeats": {"minItems": 1},
              "value_si": {"not": {"type": "null"}},
              "type_a_standard_uncertainty": {"not": {"type": "null"}},
              "type_b_standard_uncertainty": {"not": {"type": "null"}},
              "combined_standard_uncertainty": {"not": {"type": "null"}},
              "instrument_id": {"type": "string", "minLength": 1},
              "calibration_ref": {"type": "string", "minLength": 1},
              "timestamp": {"type": "string", "minLength": 1},
              "raw_data_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {"properties": {"source_type": {"const": "DERIVED_FROM_MEASURED"}}},
          "then": {
            "properties": {
              "value_si": {"not": {"type": "null"}},
              "derivation": {"type": "object"}
            }
          }
        },
        {
          "if": {"properties": {"source_type": {"const": "UNSET_REQUIRES_HUMAN"}}},
          "then": {
            "properties": {
              "raw_repeats": {"maxItems": 0},
              "value_si": {"type": "null"},
              "type_a_standard_uncertainty": {"type": "null"},
              "type_b_standard_uncertainty": {"type": "null"},
              "combined_standard_uncertainty": {"type": "null"},
              "covariance_si": {"type": "null"},
              "raw_data_sha256": {"type": "null"},
              "derivation": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
