{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/yps/e0/comparison_result.schema.json",
  "title": "YPS E0 model/experiment comparison result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "data_origin", "observable", "experimental_value", "model_value", "uncertainty_components", "combined_uncertainty", "normalized_discrepancy", "status", "claim_ceiling"],
  "properties": {
    "schema_id": {"const": "YPS-E0-COMPARISON-RESULT-1.0"},
    "data_origin": {"enum": ["SYNTHETIC", "SYNTHETIC_REAL_SHAPE_FIXTURE", "MEASURED"]},
    "observable": {"type": "string", "minLength": 1},
    "experimental_value": {"type": "number"},
    "model_value": {"type": "number"},
    "uncertainty_components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experimental", "model_input", "numerical"],
      "properties": {
        "experimental": {"type": "number", "minimum": 0},
        "model_input": {"type": "number", "minimum": 0},
        "numerical": {"type": "number", "minimum": 0}
      }
    },
    "combined_uncertainty": {"type": "number", "minimum": 0},
    "normalized_discrepancy": {"type": ["number", "null"]},
    "status": {
      "enum": [
        "CONSISTENT_WITH_CURRENT_UNCERTAINTY", "SYSTEMATIC_DISCREPANCY",
        "INCONCLUSIVE", "OUT_OF_MODEL_DOMAIN"
      ]
    },
    "claim_ceiling": {"const": "NOT_A_PHYSICAL_OR_EXPERIMENTAL_VALIDATION_CLAIM"}
  }
}
