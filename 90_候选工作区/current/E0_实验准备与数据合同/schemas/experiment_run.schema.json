{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/yps/e0/experiment_run.schema.json",
  "title": "YPS E0 first-round preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "data_origin", "plan_id", "total_result_runs", "geometry_designs", "run_families", "run_registry", "inclusion_rules"],
  "properties": {
    "schema_id": {"const": "YPS-E0-FIRST-ROUND-PLAN-1.1"},
    "data_origin": {"const": "PREREGISTERED_PLAN_NO_MEASUREMENTS"},
    "plan_id": {"type": "string", "minLength": 1},
    "total_result_runs": {"const": 70},
    "geometry_designs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["geometry_key", "target_ratio", "eta_design_center", "source_type", "manufacturing_value_status"],
        "properties": {
          "geometry_key": {"enum": ["RATIO_4_3", "RATIO_3_2", "RATIO_2_1"]},
          "target_ratio": {"enum": ["4:3", "3:2", "2:1"]},
          "eta_design_center": {"type": "string", "enum": ["7/9", "5/4", "3"]},
          "source_type": {"const": "THEORY_DESIGN_CENTER"},
          "manufacturing_value_status": {"const": "UNSET_REQUIRES_HUMAN"}
        }
      }
    },
    "run_families": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_id", "geometry_key", "release_kind", "amplitude_level_count",
          "amplitude_levels", "actual_initial_amplitude_source", "repeats_per_level", "planned_runs"
        ],
        "properties": {
          "family_id": {"type": "string", "pattern": "^F[0-9]{2}$"},
          "geometry_key": {"enum": ["RATIO_4_3", "RATIO_3_2", "RATIO_2_1"]},
          "release_kind": {"enum": ["NEAR_PURE_FAST", "NEAR_PURE_SLOW", "MIXED"]},
          "amplitude_level_count": {"type": "integer", "minimum": 1, "maximum": 4},
          "amplitude_levels": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "release_target_id", "level_index", "target_fast_rad", "target_slow_rad",
                "tolerance_rad", "source_type", "source_ref"
              ],
              "properties": {
                "release_target_id": {"type": "string", "pattern": "^F[0-9]{2}_L[0-9]{2}$"},
                "level_index": {"type": "integer", "minimum": 1, "maximum": 4},
                "target_fast_rad": {"type": "number", "minimum": 0},
                "target_slow_rad": {"type": "number", "minimum": 0},
                "tolerance_rad": {"type": "number", "exclusiveMinimum": 0},
                "source_type": {"const": "THEORY_RELEASE_TARGET"},
                "source_ref": {"type": "string", "minLength": 1}
              }
            }
          },
          "actual_initial_amplitude_source": {"const": "TRAJECTORY_RECONSTRUCTION_REQUIRED"},
          "repeats_per_level": {"const": 5},
          "planned_runs": {"type": "integer", "minimum": 5, "maximum": 20}
        }
      }
    },
    "run_registry": {
      "type": "array",
      "minItems": 70,
      "maxItems": 70,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "attempt_id", "family_id", "amplitude_level_index", "repeat_index", "apparatus_revision", "status"],
        "properties": {
          "run_id": {"type": "string", "pattern": "^E0R-F[0-9]{2}-L[0-9]{2}-R[0-9]{2}$"},
          "attempt_id": {"type": "string", "pattern": "^E0A-F[0-9]{2}-L[0-9]{2}-R[0-9]{2}-A00$"},
          "family_id": {"type": "string", "pattern": "^F[0-9]{2}$"},
          "amplitude_level_index": {"type": "integer", "minimum": 1, "maximum": 4},
          "repeat_index": {"type": "integer", "minimum": 1, "maximum": 5},
          "apparatus_revision": {"const": "UNSET_REQUIRES_HUMAN"},
          "status": {"const": "NOT_RUN"}
        }
      }
    },
    "inclusion_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_samples_per_fast_period", "target_samples_per_fast_period", "target_slow_cycles", "minimum_valid_fraction", "maximum_gap_fast_period_fraction", "stop_torus_at_first_domain_event"],
      "properties": {
        "minimum_samples_per_fast_period": {"const": 30},
        "target_samples_per_fast_period": {"const": 50},
        "target_slow_cycles": {"const": 20},
        "minimum_valid_fraction": {"const": 0.95},
        "maximum_gap_fast_period_fraction": {"const": 0.1},
        "stop_torus_at_first_domain_event": {"const": true}
      }
    }
  }
}
