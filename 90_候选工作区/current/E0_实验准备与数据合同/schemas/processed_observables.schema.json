{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/yps/e0/processed_observables.schema.json",
  "title": "YPS common experiment/model observables",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "data_origin", "identity", "valid_interval_s", "frequency", "damping", "resonant_phase", "closure_error", "event_list", "uncertainty", "domain_status"],
  "properties": {
    "schema_id": {"const": "YPS-EXPERIMENT-COMMON-OBSERVABLES-1.0"},
    "data_origin": {"enum": ["SYNTHETIC", "MEASURED", "FORMAL_MODEL"]},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_sha256"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "run_id": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "apparatus_revision": {"type": "string", "minLength": 1}
      }
    },
    "valid_interval_s": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "frequency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["omega_fast_rad_s", "omega_slow_rad_s", "ratio"],
      "properties": {
        "omega_fast_rad_s": {"type": "number", "exclusiveMinimum": 0},
        "omega_slow_rad_s": {"type": "number", "exclusiveMinimum": 0},
        "ratio": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "damping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fast_per_s", "slow_per_s"],
      "properties": {
        "fast_per_s": {"type": "number"},
        "slow_per_s": {"type": "number"}
      }
    },
    "resonant_phase": {"type": "array", "items": {"type": "number"}},
    "closure_error": {"type": "number", "minimum": 0},
    "event_list": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "time_s", "severity", "detection_method"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "time_s": {"type": "number"},
          "severity": {"enum": ["INFO", "DOMAIN_EXIT", "SAFETY_STOP"]},
          "detection_method": {"type": "string", "minLength": 1},
          "standard_uncertainty_s": {"type": ["number", "null"], "minimum": 0}
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "components", "covariance_ref"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "components": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number", "minimum": 0}
        },
        "covariance_ref": {"type": ["string", "null"]}
      }
    },
    "domain_status": {
      "enum": ["IN_DOMAIN", "OUT_OF_MODEL_DOMAIN", "TRUNCATED_AT_DOMAIN_EVENT", "ADAPTER_LIMITATION"]
    }
  }
}
