{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/yps/e0/trajectory_bundle.schema.json",
  "title": "YPS E0R provenance-bound three-dimensional trajectory bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "data_origin", "run_id", "attempt_id", "apparatus_revision",
    "detection_manifest_file", "detection_manifest_sha256", "camera_rig_sha256",
    "array_file", "array_sha256", "fields", "sample_count", "valid_fraction",
    "position_covariance_marker_ids", "covariance_convention", "event_codes"
  ],
  "properties": {
    "schema_id": {"const": "YPS-E0-TRAJECTORY-BUNDLE-1.1"},
    "data_origin": {"enum": ["MEASURED", "SYNTHETIC_REAL_SHAPE_FIXTURE"]},
    "run_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "apparatus_revision": {"type": "string", "minLength": 1},
    "detection_manifest_file": {"type": "string", "minLength": 1},
    "detection_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "camera_rig_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "array_file": {"type": "string", "minLength": 1},
    "array_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fields": {
      "type": "object",
      "minProperties": 9,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shape", "unit", "dtype"],
        "properties": {
          "shape": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "unit": {"type": "string", "minLength": 1},
          "dtype": {"type": "string", "minLength": 1}
        }
      }
    },
    "sample_count": {"type": "integer", "minimum": 1},
    "valid_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "position_covariance_marker_ids": {"const": ["BOB", "JUNCTION"]},
    "covariance_convention": {"const": "WORLD_XYZ_3X3_PER_BOB_AND_JUNCTION_SAMPLE"},
    "event_codes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
