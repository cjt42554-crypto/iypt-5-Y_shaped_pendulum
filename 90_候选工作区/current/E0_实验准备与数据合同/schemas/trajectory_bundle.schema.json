{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/yps/e0/trajectory_bundle.schema.json",
  "title": "YPS E0 trajectory bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "data_origin", "run_id", "array_file", "array_sha256", "fields", "sample_count", "valid_fraction", "event_codes"],
  "properties": {
    "schema_id": {"const": "YPS-E0-TRAJECTORY-BUNDLE-1.0"},
    "data_origin": {"enum": ["SYNTHETIC", "MEASURED"]},
    "run_id": {"type": "string", "minLength": 1},
    "array_file": {"type": "string", "minLength": 1},
    "array_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fields": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shape", "unit", "dtype"],
        "properties": {
          "shape": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "unit": {"type": "string", "minLength": 1},
          "dtype": {"type": "string", "minLength": 1}
        }
      }
    },
    "sample_count": {"type": "integer", "minimum": 1},
    "valid_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "event_codes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
