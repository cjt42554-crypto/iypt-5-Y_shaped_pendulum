{
  "schema": "YPS-HFV2-P3R2-CONTACT-ADAPTER-3.0",
  "contract_role": "self_contained_read_only_formal_registration_adapter",
  "physical_predecessor": {
    "schema": "YPS-HFV2-P3R-CONTACT-ADAPTER-2.0",
    "path": "contracts/p3r_contact_adapter_contract.json",
    "sha256": "94d85363e255a5ef5b16acd221df8ab0b1d7552255c7c399c0e492e3eada67bd",
    "physical_domain_change": false
  },
  "formal_backend": "HF-DISCRETE-ROD-RIGID-BOB-1.0",
  "formal_registration_id": "FIXED_REST_MATERIAL_SOCKETS_PROJECTIVE_V2",
  "formal_sources": {
    "model.py": {
      "path": "02_模拟程序/02_第一性原理高保真模拟器/Y-Pendulum-Simulator-v1.0.0-rc1/src/ypendulum/hf/model.py",
      "git_blob": "e1f18805cf4100055f74f36738f4137f9d7d44c6",
      "sha256": "02f8811d495aaf5cd622ca698eb8189bb31059910f081181320fb90252c553b6"
    },
    "reference.py": {
      "path": "02_模拟程序/02_第一性原理高保真模拟器/Y-Pendulum-Simulator-v1.0.0-rc1/src/ypendulum/hf/reference.py",
      "git_blob": "6c9614e999b2940da59c7a8261208c91aa8a217d",
      "sha256": "2049d67d80ad72027060035286e7c33f9728d2bec846519c4688335588e241aa"
    }
  },
  "adapter_policy": {
    "formal_import_allowed": false,
    "formal_files_writable": false,
    "implementation": "read_only_inheritance_of_frozen_P3R_physical_registration_with_new_assembly_identity",
    "physical_domain_change_from_p3_a1_or_p3r": false
  },
  "surface_parameters": {
    "branch_contact_radius": "assembly_contract_by_branch_id",
    "bob_contact_radius": "assembly_contract",
    "minimum_clearance": "assembly_contract",
    "all_values_enter_contact_assembly_identity": true
  },
  "same_branch": {
    "minimum_material_separation": "1.01*(2*branch_radius+minimum_clearance)",
    "full_domain": "unit_square_if_second_material_start_minus_first_material_end_is_not_less_than_minimum_material_separation",
    "partial_domain": "unit_square_intersection_with_S_second(eta)-S_first(xi)>=minimum_material_separation",
    "required_center_distance": "2*branch_radius+minimum_clearance",
    "identity": "one_unordered_segment_pair_per_nonempty_registered_domain"
  },
  "junction_socket": {
    "applies_to": "each_unordered_branch_pair_sharing_exactly_one_non_bob_endpoint",
    "required_center_distance": "first_branch_radius+second_branch_radius+minimum_clearance",
    "socket_length_each_branch": "2*required_center_distance",
    "physical_active_domain": "full_segment_pair_domain_minus_states_where_both_material_points_are_strictly_inside_their_registered_sockets",
    "identity_granularity": "one_nonempty_two_dimensional_convex_piece_per_constraint",
    "piece_partition": [
      {
        "role": "first_outside",
        "domain": "first_material_distance>=first_socket_length_with_second_coordinate_unrestricted"
      },
      {
        "role": "second_outside_first_inside",
        "domain": "first_material_distance<=first_socket_length_and_second_material_distance>=second_socket_length"
      }
    ],
    "piece_interior_overlap": false,
    "closed_shared_boundary": true,
    "duplicate_active_witness_on_shared_boundary": "retain_both_identities_and_report_rank_or_dual_degeneracy",
    "registered_projective_opening_squared": "(required_center_distance/(2*socket_length))^2"
  },
  "bob_socket": {
    "attachment_branch": "unique_branch_ending_at_unique_bob_attachment_node",
    "socket_length": "bob_contact_radius+attachment_branch_radius+minimum_clearance",
    "attachment_branch_active_domain": "material_distance_from_attachment>=socket_length",
    "other_branch_active_domain": "complete_segment",
    "required_center_distance": "bob_contact_radius+branch_radius+minimum_clearance",
    "identity": "one_bob_segment_active_interval_constraint"
  },
  "physical_contact_inequalities": {
    "sign": "gap_m>=0",
    "units": "m",
    "jacobian": "analytic_unique_closest_witness_envelope_gradient",
    "identity_order": "registered_segment_pair_constraints_then_registered_bob_segment_constraints"
  },
  "socket_validity_inequalities": {
    "sign": "signed_residual>=0",
    "identity_order": "bob_material_extent_bob_radial_margin_bob_cut_margin_then_each_junction_registration_material_extent_projective_margin_cut_margin",
    "rows": [
      {
        "suffix": "material_extent",
        "residual": "total_reference_material_length-socket_reference_material_length",
        "unit": "m",
        "threshold_included_in_residual": 0.0
      },
      {
        "suffix": "radial_monotonicity_margin",
        "residual": "minimum_socket_cell_dot(start_minus_bob,end_minus_start)-socket_radial_monotonicity_min_m2",
        "unit": "m^2"
      },
      {
        "suffix": "projective_opening_margin",
        "residual": "minimum_projective_opening_squared-registered_projective_opening_squared-socket_projective_opening_margin_min",
        "unit": "1"
      },
      {
        "suffix": "cut_gap_margin",
        "residual": "socket_cut_center_distance-required_center_distance-socket_cut_gap_min_m",
        "unit": "m"
      }
    ],
    "solver_jacobian": "fixed_centered_difference_of_each_signed_residual",
    "independent_jacobian_crosscheck": "five_point_centered_stencil_at_separately_frozen_steps",
    "final_candidate_policy": "every_signed_residual_must_pass_the_frozen_strict_interior_gate"
  },
  "evaluation_failure_policy": {
    "finite_socket_domain_violation": "return_identity_signed_residual_and_jacobian_to_the_single_solver",
    "nonfinite_coordinate_or_geometry": "fail_closed",
    "coordinate_chart_violation": "fail_closed",
    "collapsed_segment": "fail_closed",
    "zero_witness_distance_with_undefined_normal": "fail_closed",
    "separated_equal_closest_minimizers": "fail_closed",
    "empty_or_degenerate_registered_parameter_domain": "fail_closed",
    "duplicate_constraint_identity_or_canonical_domain": "fail_closed"
  },
  "canonical_identity": {
    "branch_order": "topology_first_appearance_then_material_segment_order",
    "unordered_pair_order": "canonical_branch_and_segment_identity_order",
    "numeric_serialization": "IEEE754_finite_JSON_sort_keys_compact_separators_allow_nan_false",
    "adapter_hash_enters_assembly_identity": true,
    "protocol_hash_enters_assembly_identity": true,
    "component_scale_and_composite_algorithm_enter_P3R2_assembly_identity": true
  },
  "excluded": [
    "friction",
    "restitution",
    "compliant_or_penalty_contact",
    "ground_or_external_obstacle_contact",
    "dynamic_contact_or_impulse",
    "knot_sliding_or_topology_change"
  ]
}
