include README.md LICENSE CHANGELOG.md CITATION.cff THIRD_PARTY_NOTICES.md
include Dockerfile .dockerignore .gitignore
include CODEX_CONTINUATION_AND_ENVIRONMENT_GAPS.md
include MANIFEST.in
recursive-include src/ypendulum *.py
recursive-include docs *.md
recursive-include configs *
recursive-include examples *
recursive-include tests *.py
recursive-include validation *.md *.json *.yaml *.csv
recursive-include benchmarks *.py *.md *.json
recursive-include scripts *.py
recursive-include .github *.yml *.yaml
prune runs
prune dist
prune build
prune .git
prune .pytest_cache
global-exclude *.py[cod] __pycache__ .DS_Store

# An sdist cannot truthfully contain a checksum of itself.
exclude validation/python_artifact_checksums.txt
